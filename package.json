{
  "name": "fb-group-market",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "รวมรายการสินค้าจากกลุ่ม Facebook ที่คุณเลือก — ค้นหา กรอง และกดไปยังโพสต์ต้นทาง (ข้อมูลอยู่ในเครื่องผู้ใช้เท่านั้น)",
  "scripts": {
    "dev": "npm run build:bm && vite",
    "build:bm": "node scripts/build-bookmarklet.mjs",
    "build": "npm run build:bm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:bm && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "fuse.js": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
